<div class="product-show">
  <h1>My Orders</h1>

  <% if @orders.empty? %>
    <p>You haven't placed any orders yet. <%= link_to "Start shopping", products_path %></p>
  <% else %>
    <table class="cart-table">
      <thead>
        <tr>
          <th>Order #</th>
          <th>Date</th>
          <th>Items</th>
          <th>Tax</th>
          <th>Total</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td>#<%= order.id %></td>
            <td><%= order.created_at.strftime("%B %d, %Y") %></td>
            <td><%= order.order_items.sum(:quantity) %> items</td>
            <td><%= number_to_currency(order.tax_amount) %></td>
            <td><%= number_to_currency(order.total_amount) %></td>
            <td><span class="status-badge"><%= order.status.capitalize %></span></td>
            <td><%= link_to "View", order_path(order), class: "btn-small" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>