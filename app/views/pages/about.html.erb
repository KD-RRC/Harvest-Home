<div class="product-show">
  <div class="breadcrumb">
    <%= link_to "Home", root_path %> &rsaquo; About
  </div>
  <h1 style="color: #2d6a4f; margin-bottom: 1rem;">About Harvest & Home</h1>
  <div class="product-detail-description">
    <h3>Our Story</h3>
    <p>Harvest & Home is a Manitoba-based online marketplace connecting local food producers directly with consumers across the province. We believe in supporting local farmers, artisans, and food makers by giving them a professional platform to reach customers year-round.</p>
  </div>
  <div class="product-detail-description">
    <h3>Our Mission</h3>
    <p>To make Manitoba's best local food accessible to everyone — whether you're in Winnipeg or a rural community — while keeping money in the hands of the people who grow and make it.</p>
  </div>
  <%= link_to "Start Shopping", products_path, class: "btn-primary" %>
</div>
